# Copernicus Data Space Ecosystem API (Sentinel-2 Access)
COPERNICUS_USERNAME=your_copernicus_username_here
COPERNICUS_PASSWORD=your_copernicus_password_here

# Google Earth Engine (Optional, if authorized)
GEE_SERVICE_ACCOUNT=your_gee_service_account@project.iam.gserviceaccount.com
GEE_PRIVATE_KEY_PATH=./secrets/gee_private_key.json

# API & Server Configuration
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
VITE_API_URL=http://127.0.0.1:8000

# ML Inference Device (cpu / cuda)
ML_INFERENCE_DEVICE=cpu
